{
  // Example shell-warden policy, config v2 (design/shell-warden-config-v2.md):
  // per-executable profiles; allow is a typing-evidence coverage proof.
  // spawn example: shell-warden --config <this file> (letter on stdin).
  "version": 2,
  "defaults": {
    "action": "ask",
    "message": "No approved command profile matched.",
    "redirectPolicy": "safe-local-io"
  },
  "redirectPolicies": {
    "safe-local-io": {
      "redirects": { "all": [{ "sourceFd": "default", "operator": ">", "occurrence": "all", "target": { "kind": "literalPath" } }] },
      "paths": { "all": [{ "coordinate": { "redirect": { "operator": ">", "sourceFd": "default", "occurrence": "all" } }, "within": "/tmp/reports" }] }
    },
    "no-redirects": {
      "redirects": { "none": true },
      "paths": { "none": true }
    }
  },
  "profiles": [
    {
      "id": "git",
      "executables": ["git"],
      "options": {
        "force": { "aliases": ["--force", "-f"], "arity": 0 },
        "dryRun": { "aliases": ["--dry-run", "-n"], "arity": 0 },
        "oneline": { "aliases": ["--oneline"], "arity": 0 }
      },
      "analyzer": "generic-v1",
      "rules": [
        {
          "id": "git/deny-force-push",
          "action": "deny",
          "message": "push --force is forbidden — history is protected",
          "match": {
            "arguments": { "prefix": ["push"] },
            "options": { "presentAny": ["force"] }
          }
        },
        {
          "id": "git/allow-status",
          "action": "allow",
          "match": {
            "classification": "complete",
            "arguments": { "exact": ["status"] },
            "options": { "none": true },
            "environment": { "none": true },
            "paths": { "none": true },
            "facts": { "none": true },
            "nestedParts": { "none": true }
          }
        },
        {
          "id": "git/allow-status-append-report",
          "action": "allow",
          "redirectPolicy": {
            "mode": "extend",
            "inline": {
              "redirects": { "all": [{ "sourceFd": "default", "operator": ">>", "occurrence": "all", "target": { "kind": "literalPath" } }] },
              "paths": { "all": [{ "coordinate": { "redirect": { "operator": ">>", "sourceFd": "default", "occurrence": "all" } }, "within": "/var/tmp/git-reports" }] }
            }
          },
          "match": {
            "classification": "complete",
            "arguments": { "exact": ["status"] },
            "options": { "none": true },
            "environment": { "none": true },
            "paths": { "none": true },
            "facts": { "none": true },
            "nestedParts": { "none": true }
          }
        },
        {
          "id": "git/allow-log-oneline",
          "action": "allow",
          "redirectPolicy": { "mode": "replace", "policies": ["no-redirects"] },
          "match": {
            "classification": "complete",
            "arguments": { "exact": ["log"] },
            "options": { "allowed": [{ "option": "oneline", "required": true, "repeatable": false }] },
            "environment": { "none": true },
            "paths": { "none": true },
            "facts": { "none": true },
            "nestedParts": { "none": true }
          }
        },
        {
          "id": "git/allow-push-dry-run",
          "action": "allow",
          "redirectPolicy": { "mode": "replace", "policies": ["no-redirects"] },
          "match": {
            "classification": "complete",
            "arguments": { "exact": ["push", "origin", "main"] },
            "options": { "allowed": [{ "option": "dryRun", "required": true, "repeatable": false }] },
            "environment": { "none": true },
            "paths": { "none": true },
            "facts": { "none": true },
            "nestedParts": { "none": true }
          }
        }
      ]
    },
    {
      "id": "node-version",
      "executables": ["node"],
      "options": { "version": { "aliases": ["--version", "-V"], "arity": 0 } },
      "redirectPolicy": { "mode": "replace", "policies": ["no-redirects"] },
      "analyzer": "generic-v1",
      "rules": [
        {
          "id": "node-version/allow-bare-version",
          "action": "allow",
          "match": {
            "classification": "complete",
            "arguments": { "exact": [] },
            "options": { "allowed": [{ "option": "version", "required": true, "repeatable": false }] },
            "environment": { "none": true },
            "paths": { "none": true },
            "facts": { "none": true },
            "nestedParts": { "none": true }
          }
        }
      ]
    },
    {
      "id": "rm",
      "executables": ["rm"],
      "options": {
        "force": { "aliases": ["-f"], "arity": 0 },
        "recursive": { "aliases": ["-r"], "arity": 0 },
        "recursiveForce": { "aliases": ["-rf"], "arity": 0 }
      },
      "analyzer": "generic-v1",
      "rules": [
        {
          "id": "rm/no-etc",
          "action": "deny",
          "message": "do not delete system files",
          "match": {
            "arguments": { "containsAny": ["/etc", "/etc/*"] }
          }
        }
      ]
    },
    {
      "id": "docker",
      "executables": ["docker"],
      "options": {
        "volume": { "aliases": ["--volume", "-v"], "arity": 1 },
        "detach": { "aliases": ["-d"], "arity": 0 }
      },
      "analyzer": "generic-v1",
      "rules": [
        {
          "id": "docker/no-root-mount",
          "action": "deny",
          "message": "do not mount / into the container",
          "match": {
            "arguments": { "exact": ["run"] },
            "options": { "values": { "volume": { "regex": "/:.*" } } }
          }
        }
      ]
    }
  ]
}
